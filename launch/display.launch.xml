<?xml version="1.0"?>
<launch>
  
  <!-- Converts the xacro file into the urdf using xacro package and saves it in the urdf_file variable -->
  <let name="urdf_file" value="$(command 'xacro $(find-pkg-share justina_description)/urdf/justina/justina.xacro')"/>

  <!-- Node to publish the robot description -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(var urdf_file)" />
  </node>

  <!-- GUI to move joints manually -->
  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" name="joint_state_publisher" output="screen"/>

  <!-- RViz2 visualization -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(find-pkg-share justina_description)/rviz/justina.rviz"/>
</launch>

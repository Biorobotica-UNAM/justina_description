<?xml version="1.0"?>
<robot name="robotino" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- NOTE Wheels have 0.01 offset from ground to match with visual texture floor in LAB world -->

    <!-- Base Robotino -->
    <link name="base_link">
        <inertial>
            <mass value="10.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </inertial>

        <visual>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://justina_description/meshes/robotino_low_poly/Robotino3_LowPoly.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 -0.03" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://justina_description/meshes/robotino_low_poly/Robotino3_Collider_LowPoly.dae" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <!-- Wheel Macro -->
    <xacro:macro name="wheel" params="name x y z rpy">
        <link name="${name}_link">
            <inertial>
                <mass value="0.5"/>
                <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </inertial>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://justina_description/meshes/robotino_low_poly/Robotino3_Wheel_Very_LowPoly.dae" scale="1 1 1"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.570796 0 0"/>
                <geometry>
                    <cylinder radius="0.062" length="0.058"/>
                </geometry>
            </collision>
        </link>

        <joint name="${name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${name}_link"/>
            <origin xyz="${x} ${y} ${z}" rpy="0 0 ${rpy}"/>
            <axis xyz="0 1 0"/>
        </joint>

        <transmission name="${name}_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${name}_joint">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </joint>
            <actuator name="${name}_motor">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>

    <!-- Wheels -->
    <xacro:wheel name="wheel0" x="-0.1825" y="-0.0001" z="0.01" rpy="1.570796"/>
    <xacro:wheel name="wheel1" x="0.090625" y="-0.157067" z="0.01" rpy="3.665191"/>
    <xacro:wheel name="wheel2" x="0.090625" y="0.156867" z="0.01" rpy="-0.523599"/>

    <!-- Hokuyo LIDAR -->
    <link name="laser_link">
        <inertial>
            <mass value="0.3"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 1.57"/>
            <geometry>
                <mesh filename="package://justina_description/meshes/robotino_low_poly/sensors/Hokuyo_Clean.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
                <box size="0.05 0.05 0.07"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_to_hokuyo" type="fixed">
        <parent link="base_link"/>
        <child link="laser_link"/>
        <origin xyz="0.07 0.0 0.16" rpy="0 0 0"/>
    </joint>

    <!-- tower -->
    <link name="tower_link">
        <inertial>
            <mass value="2.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://justina_description/meshes/robotino_low_poly/Justina_Platform_LowPoly.dae" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0.49" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.075" length="0.59"/>
            </geometry>
        </collision>
    </link>

    <!-- tower have an offset of 0.06 -->
    <joint name="tower_joint" type="fixed">
        <parent link="base_link"/>
        <child link="tower_link"/>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    </joint>

</robot>
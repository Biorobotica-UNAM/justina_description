<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="justina">
  <!-- <xacro:include filename="$(find justina_description)/urdf/justina/components/justina_head.gazebo"/> -->
  <xacro:property name="M_PI" value="3.1415926535897931" />
  
  <!--HEAD LINKS AND JOINTS-->
  <link name="head_link1">
    <inertial>
      <origin xyz="0.0 0 0.0" rpy = "0 0 0"/>
      <mass value = "0.15" />
      <inertia ixx = "0.00052" iyy = "0.00052" izz = "0.00004" ixy = "0" ixz = "0" iyz = "0" />
    </inertial>

    <visual>
      <origin xyz= "0.0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/servos/Servo_Mx64_LowPoly.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz= "0.0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/servos/Servo_Mx64_LowPoly.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  
  <link name="head_link2">
    <inertial>
      <origin xyz="0.0 0 0.0" rpy = "0 0 0"/>z
      <mass value = "0.15" />
      <inertia ixx = "0.00003125" iyy = "0.00003125" izz = "0.00003125" ixy = "0" ixz = "0" iyz = "0" />
    </inertial>

    <visual>
      <origin xyz= "0 0.0 0.06" rpy="${M_PI/2} -${M_PI/2} 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/servos/Servo_Mx64_LowPoly.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz= "0 0.0 0.06" rpy="${M_PI/2} -${M_PI/2} 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/servos/Servo_Mx64_LowPoly.dae" scale="1 1 1"/>
      </geometry>
    </collision>

  </link>
  
  <joint name="head_pan" type="revolute">
    <origin xyz="0.0 0 0.035" rpy="0 0 0" />
    <parent link="head_link1"/>
    <child link="head_link2"/>
    <axis xyz="0 0 1" />
    <dynamics damping ="0.1" />
    <limit effort="6.0" velocity="3.0" lower="-1.57" upper="1.57"/>
  </joint>

  <link name="neck_link">
    <inertial>
      <origin xyz="0.0 0 0.0" rpy = "0 0 0"/>
      <mass value = "0.15" />
      <inertia ixx = "0.00006205" iyy = "0.000555" izz = "0.0005776" ixy = "0" ixz = "0" iyz = "0" />
    </inertial>

    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/head/FaceMask_LowPoly.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz= "0 0 -0.125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/head/FaceMask_Collider_Low.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_tilt" type="revolute">
    <origin xyz="0.0 0 0.06" rpy="0 0 0"/>
    <parent link="head_link2"/>
    <child link="neck_link"/>
    <axis xyz="0 -1 0" />
    <dynamics damping ="0.1" />
    <limit effort="6.0" velocity="3.0" lower="-1.2" upper="1.0"/>
  </joint>
  
  <link name="camera_link">
    <inertial>
      <origin xyz="0.0 0 0.0" rpy = "0 0 0"/>
      <mass value = "0.1" />
      <inertia ixx = "0.00006205" iyy = "0.000555" izz = "0.0005776" ixy = "0" ixz = "0" iyz = "0" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>camera_link
        <mesh filename="package://justina_description/meshes/robotino_low_poly/sensors/kinect_LowPoly_B.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz= "0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/robotino_low_poly/sensors/kinect_Collider_B.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="camera_link_connect" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="neck_link"/>
    <child link="camera_link"/>
  </joint>

</robot>
  

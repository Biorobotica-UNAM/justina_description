<?xml version="1.0"?>
<robot name="justina_torso"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="box_inertia" params="m x y z">
        <inertia ixx="${m*(y*y+z*z)/12}" ixy = "0" ixz = "0" iyy="${m*(x*x+z*z)/12}" iyz = "0" izz="${m*(x*x+z*z)/12}"/>
    </xacro:macro>

    <xacro:property name="torso_mass" value="0.6"/>
    <xacro:property name="spine_mass" value="0.1"/>

    <link name="torso_link">
        <inertial>
            <mass value="${torso_mass}"/>
            <origin xyz= "0 0 -0.55" rpy="0 0 0"/>
            <xacro:box_inertia m="${torso_mass}" x="0.07" y="0.09" z="0.05"/>
        </inertial>

        <visual>
            <origin xyz= "0.0 0.0 -0.1" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://justina_description/meshes/justina/torso/Justina_Torso_LowPoly.dae"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz= "0.0 0.0 -0.1" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://justina_description/meshes/justina/torso/Justina_Torso_LowPoly.dae"/>
            </geometry>
        </collision>
    </link>

    <joint name="spine_connect" type="fixed">
        <origin xyz= "0.0 0 0.35" rpy="0 0 0"/>
        <parent link="torso_link"/>
        <child link="spine_link"/>
    </joint>

    <link name="spine_link">
        <inertial>
            <mass value="${spine_mass}"/>
            <origin xyz= "0.0 0.0 -0.5325" rpy="0 0 0"/>
            <xacro:box_inertia m="${spine_mass}" x="0.05" y="0.05" z="0.5"/>
        </inertial>
    </link>

</robot>
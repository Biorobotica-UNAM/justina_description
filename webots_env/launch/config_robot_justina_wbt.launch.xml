<launch>
  <!-- Get the package share directory -->
  <let name="package_share" value="$(find-pkg-share justina_description)" />

  <!-- ================= Launch Webots ================= -->
  <let name="world_path" value="$(var package_share)/webots_env/worlds/configuring_robot.wbt" />
  <let name="controllers_path" value="$(var package_share)/webots_env/controllers" />

  <executable cmd="webots --mode=realtime $(var world_path)" output="screen">
    <env name="WEBOTS_CONTROLLER_PATH" value="$(var controllers_path)" />
    <env name="DISPLAY" value="$(env DISPLAY :0)" />
  </executable>


  <!-- =============== robot_state_publisher =============== -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <!-- Load the URDF generated by Webots -->
    <param name="robot_description"
          value="$(command 'cat $(var package_share)/webots_env/urdf/Robot.urdf')" />
    <!-- Tell the node to use simulation time -->
    <param name="use_sim_time" value="true" />
    <remap from="joint_states" to="joint_states"/>
  </node>


  <!-- ========== Static transform from map to odom ========== -->
  <!-- Often required for navigation; the actual transform will be provided by the localization later -->
  <node pkg="tf2_ros" exec="static_transform_publisher" 
      args="--x 0 --y 0 --z 0 --roll 0 --pitch 0 --yaw 0 --frame-id map --child-frame-id odom"/>


  <!-- RViz custom config -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(var package_share)/webots_env/rviz/justina_wbt.rviz">
    <param name="use_sim_time" value="true" />
  </node>


  <!-- JOYSTICK -->
  <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
    <remap from="joy" to="/hardware/joy"/>
  </node>
  <node pkg="justina_description" exec="robot_teleop.py" name="robot_teleop" output="screen">
    <param name="use_sim_time" value="true" />
  </node>

</launch>